# NextAuth
NEXTAUTH_SECRET=<generate: openssl rand -base64 32>
NEXTAUTH_URL=https://your-app.dokploy.com

# Google OAuth (same app used for Drive access)
GOOGLE_CLIENT_ID=<from Google Cloud Console → APIs & Services → Credentials>
GOOGLE_CLIENT_SECRET=<from Google Cloud Console>

# Google Drive API (server-side file listing)
GOOGLE_REFRESH_TOKEN=<from ~/.config/en_report/google_token.json → refresh_token field>
# drive.readonly token — REQUIRED to see files uploaded by hand in the Drive UI.
# GOOGLE_REFRESH_TOKEN above only has the drive.file scope (app-created files only).
# Mint with: python3 web/get_drive_token.py   (set the same value on the agent)
GDRIVE_DL_REFRESH_TOKEN=<from web/drive_readonly_token.json → refresh_token field>
GDRIVE_RAW_FOLDER_ID=1L4qIfD4bha6oZpZTe7s5LbNcgRAgqLlL
GDRIVE_FORMA_FOLDER_ID=1tUzez4CpPUV9oks8XUY-HzBen54Q0AYs
NEXT_PUBLIC_GDRIVE_RAW_FOLDER_ID=1L4qIfD4bha6oZpZTe7s5LbNcgRAgqLlL
NEXT_PUBLIC_GDRIVE_FORMA_FOLDER_ID=1tUzez4CpPUV9oks8XUY-HzBen54Q0AYs

# Agent service (deployed separately on Dokploy)
AGENT_SERVICE_URL=https://your-agent.dokploy.com
AGENT_WEBHOOK_SECRET=<shared secret — must match agent's AGENT_WEBHOOK_SECRET>
